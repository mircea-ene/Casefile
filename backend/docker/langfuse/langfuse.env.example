# Langfuse (web + worker) settings for local development. These secrets are local-only;
# generate new ones (openssl rand -hex 32) for any shared or deployed instance.
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=CHANGEME
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME
TELEMETRY_ENABLED=false
AUTH_DISABLE_SIGNUP=true

# Database and role created by docker/postgres/init-langfuse.sql.
DATABASE_URL=postgresql://langfuse:CHANGEME@postgres:5432/langfuse

CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME
CLICKHOUSE_CLUSTER_ENABLED=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=CHANGEME

# Event and media store: the Terraform-managed bucket in Floci (S3 on the host's :4566).
# Events (trace batches) land here before the worker loads them into ClickHouse.
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=local-infra-local-langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=us-east-1
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=test
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=test
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://host.docker.internal:4566
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=local-infra-local-langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=us-east-1
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=test
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=test
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://host.docker.internal:4566
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/

# First start creates this org, project, API keys and login (ignored once they exist).
# The backend's .env needs the same LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY.
LANGFUSE_INIT_ORG_ID=accelerise
LANGFUSE_INIT_ORG_NAME=Accelerise
LANGFUSE_INIT_PROJECT_ID=rag-backend
LANGFUSE_INIT_PROJECT_NAME=rag-backend
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_INIT_USER_EMAIL=admin@accelerise.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGEME
