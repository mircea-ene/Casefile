# Postgres superuser and app database (local only; not committed). The backend's
# DATABASE_URL must use the same user, password and database.
POSTGRES_USER=casefile_user
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=casefile
# Password of Langfuse's own role; must match DATABASE_URL in docker/langfuse/langfuse.env.
LANGFUSE_DB_PASSWORD=CHANGEME
