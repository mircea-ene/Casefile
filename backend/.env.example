DATABASE_URL=postgresql+psycopg://casefile_user:CHANGEME@localhost:5432/casefile
CORS_ORIGINS=http://localhost:3000

# Local Cognito (Floci). For real Cognito: issuer https://cognito-idp.<region>.amazonaws.com/<pool id>,
# JWKS <issuer>/.well-known/jwks.json.
COGNITO_USER_POOL_ID=us-east-1_63b12053a
COGNITO_CLIENT_ID=cbf8bd4caba94246900339a1a5
COGNITO_ISSUER=http://localhost:4566/us-east-1_63b12053a
COGNITO_JWKS_URL=http://localhost.floci.io:4566/us-east-1_63b12053a/.well-known/jwks.json

# Original files. For real AWS, drop AWS_ENDPOINT_URL and the keys (boto3 uses its default chain).
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=local-infra-local-backend
MAX_UPLOAD_BYTES=52428800
# Uploads go under this prefix; EventBridge queues them for indexing (Terraform-managed).
S3_UPLOAD_PREFIX=uploads/

# Indexing queue consumed by `python -m app.worker` (Terraform-managed).
SQS_QUEUE_URL=http://localhost:4566/000000000000/local-infra-local-uploads
FILE_URL_EXPIRES_SECONDS=300

# LM Studio server (Developer tab > Start Server). Model ids must match GET /v1/models.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen/qwen3.8-27b
EMBEDDING_MODEL=text-embedding-qwen3-embedding-8b
EMBEDDING_DIMENSIONS=1024
RETRIEVAL_MIN_SIMILARITY=0.4
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40

# Parsing / chunking (Docling). OCR_ENGINE: ocrmac (macOS), auto, none.
OCR_ENGINE=ocrmac
# Model downloads (Hugging Face, Docling). Defaults to .cache/ in this directory.
# CACHE_DIR=.cache
CHUNK_TOKENIZER=Qwen/Qwen3-Embedding-8B
CHUNK_MIN_TOKENS=200
CHUNK_MAX_TOKENS=800

# Langfuse tracing (docker compose, UI on http://localhost:3001). Use the
# LANGFUSE_INIT_PROJECT_* keys from docker/langfuse/langfuse.env; leave unset to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3001
