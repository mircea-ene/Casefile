# Cognito user pool and app client (browser-visible)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_63b12053a
NEXT_PUBLIC_COGNITO_CLIENT_ID=cbf8bd4caba94246900339a1a5

# Local Cognito emulator (Floci). Floci doesn't answer CORS preflight, so the
# browser talks to /cognito on this origin and Next.js rewrites it to Floci.
# Leave both unset to use real Cognito.
NEXT_PUBLIC_COGNITO_ENDPOINT=http://localhost:3000/cognito
COGNITO_DEV_PROXY_TARGET=http://localhost.floci.io:4566

# FastAPI backend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
