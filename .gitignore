# OS / editors
.DS_Store
.idea/
.vscode/
*.swp

# Secrets (each has a committed .example template)
.env
.env.*
!.env.example
backend/docker/postgres/postgres.env
backend/docker/langfuse/langfuse.env

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/

# Backend: model downloads and the CUAD dataset (atticusprojectai.org/cuad)
backend/.cache/
backend/CUAD_v1/

# Docker bind-mounted volumes (service data)
**/docker/*_data/
**/floci-data/

# Frontend (more rules in frontend/.gitignore)
node_modules/
.next/
*.tsbuildinfo

# Agent scratch
.superpowers/

# Terraform: provider cache, state, plans, crash logs, local overrides.
# .terraform.lock.hcl is committed (pins provider versions).
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Variable files can hold secrets.
*.tfvars
*.tfvars.json

# Working docs (design notes, plans, frontend/backend handovers): local only
backend/docs/
frontend/docs/
